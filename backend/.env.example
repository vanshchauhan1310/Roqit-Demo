# Supabase: Project Settings > Database > Connection string (URI), use the "Session pooler" or
# "Transaction pooler" host if connecting from a serverless/edge environment.
# psycopg2 needs the postgresql+psycopg2:// scheme (Supabase gives you postgresql://).
# When running via docker-compose, leave these unset — the compose file injects
# service-hostname URLs (postgres, redis, ml) automatically.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
ML_SERVICE_URL=http://localhost:8001
BACKEND_CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-to-a-long-random-string

# Nominatim (OpenStreetMap) geocoding — free, no API key. Their policy requires a
# real identifying User-Agent (app name + contact), not a generic one.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=FleetOptimizationPlatform/1.0 (youremail@example.com)

# OpenWeather Current Weather API — per-stop weather, cached on route_stops and
# refreshed once the cached value is over an hour old. Get a free key at openweathermap.org.
OPENWEATHER_API_KEY=
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/weather

# Redis (queue + cache). Only needed when running outside docker-compose.
REDIS_URL=redis://localhost:6379/0
